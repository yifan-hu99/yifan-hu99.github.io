generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Conversation {
  ownerId String @default("legacy")
  @@index([ownerId])
  id String @id @default(cuid())
  title String
  intent Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  runs SearchRun[]
}
model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role String
  text String
  blocks Json
  createdAt DateTime @default(now())
  @@index([conversationId, createdAt])
}
model SearchRun {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  intent Json
  report Json
  results Json
  createdAt DateTime @default(now())
}
model Opportunity {
  ownerId String @default("legacy")
  @@index([ownerId])
  id String @id
  payload Json
  createdAt DateTime @default(now())
  items LibraryItem[]
  drafts OutreachDraft[]
}
model LibraryItem {
  ownerId String @default("legacy")
  @@index([ownerId])
  id String @id @default(cuid())
  opportunityId String
  @@unique([ownerId, opportunityId])
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  status String @default("SAVED")
  notes String @default("")
  savedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events ActionEvent[]
}
model ActionEvent {
  id String @id @default(cuid())
  libraryItemId String
  libraryItem LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  type String
  detail String
  createdAt DateTime @default(now())
}
model Profile {
  id String @id @default("local")
  name String @default("")
  location String @default("")
  skills String @default("")
  preferences String @default("")
  portfolio String @default("")
  useForMatching Boolean @default(false)
  useForDrafts Boolean @default(false)
  onboardingCompleted Boolean @default(false)
}
model Resume {
  ownerId String @default("legacy")
  @@index([ownerId])
  id String @id @default(cuid())
  filename String
  text String
  preview String
  createdAt DateTime @default(now())
}
model OutreachDraft {
  ownerId String @default("legacy")
  @@index([ownerId])
  id String @id @default(cuid())
  opportunityId String
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  body String
  status String @default("DRAFT")
  createdAt DateTime @default(now())
}