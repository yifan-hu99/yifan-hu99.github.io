{
  "name": "cambium-opportunity-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/generate-client.mjs && node scripts/build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:setup": "node scripts/init-db.mjs && prisma migrate deploy",
    "postinstall": "node scripts/generate-client.mjs",
    "start:railway": "node scripts/start-railway.mjs",
    "vercel-build": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "6.19.0",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "6.19.0",
    "vitest": "^3.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "@playwright/test": "^1.56.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
